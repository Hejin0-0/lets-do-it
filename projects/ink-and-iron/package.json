{
  "name": "war-library",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build && node scripts/inline-single-file.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "playwright test",
    "verify:visual": "playwright test tests/visual.spec.ts",
    "inspect:canvas": "node scripts/inspect-threejs-canvas.mjs",
    "test:rules": "node --test \"tests/rules/**/*.test.ts\"",
    "selfplay": "node scripts/selfplay.ts",
    "test:e2e": "playwright test tests/e2e",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lil-gui": "^0.21.0",
    "three": "^0.184.0",
    "@lid/random": "file:../../packages/random",
    "@lid/storage": "file:../../packages/storage",
    "@lid/loop": "file:../../packages/loop",
    "@lid/dev-kit": "file:../../packages/dev-kit"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.0",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.184.1",
    "pngjs": "^7.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.13"
  }
}
